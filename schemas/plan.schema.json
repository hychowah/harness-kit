{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Plan link record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project_id", "title", "status", "pack", "depth", "created", "paths", "sessions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["open", "closed"]},
    "pack": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "depth": {"type": "string", "enum": ["low", "medium", "high"]},
    "created": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "sessions": {"type": "array", "items": {"type": "string"}}
  }
}
