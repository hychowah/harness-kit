{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack.schema.json",
  "title": "Pack graph",
  "description": "Shape of a pack graph. scripts/pack.py loads this file and crashes when the shape or the graph is wrong. A broken pack is not a check result. Predicate names and meanings live in scripts/checks.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "uses_features", "architecture_on_close", "checks", "nodes"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "uses_features": {"type": "boolean"},
    "architecture_on_close": {"type": "boolean"},
    "checks": {"type": ["string", "null"]},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "glob"],
      "properties": {
        "predicate": {"type": "string", "minLength": 1},
        "glob": {"type": "string", "minLength": 1},
        "root": {"type": "string", "enum": ["session", "project"]},
        "min": {"type": "integer", "minimum": 1},
        "optional": {"type": "boolean"},
        "schema": {"type": "string", "minLength": 1}
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "specialist", "exclusive"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "specialist": {"type": "boolean"},
        "exclusive": {"type": "boolean"},
        "priors": {"type": "array", "items": {"type": "string"}},
        "reads": {"type": "array", "items": {"type": "string"}},
        "forbidden": {"type": "array", "items": {"type": "string"}},
        "owns": {"type": "array", "items": {"type": "string"}}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priors", "entry", "complete", "workers"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "priors": {"type": "array", "items": {"type": "string"}},
        "entry": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "complete": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "workers": {"type": "array", "items": {"$ref": "#/$defs/worker"}}
      }
    }
  }
}
